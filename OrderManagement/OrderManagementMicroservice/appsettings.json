{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=OrderDb;Username=rubindev;Password=12345"
  },
  "Jwt": {
    "Key": "THIS_IS_A_VERY_SECURE_KEY_123456",
    "Issuer": "AuthApi",
    "Audience": "AuthApiUsers",
    "ExpireHours": 1
  },
  "WhatsApp": {
    "PhoneNumberId": "YOUR_PHONE_NUMBER_ID",
    "AccessToken": "YOUR_META_ACCESS_TOKEN",
    "VerifyToken": "my_custom_verify_token_abc123",
    "AppSecret": "YOUR_META_APP_SECRET"
  },
  "Razorpay": {
    "KeyId": "rzp_test_xxxxxxxxxxxxxxxx",
    "KeySecret": "YOUR_RAZORPAY_SECRET",
    "WebhookSecret": "YOUR_WEBHOOK_SECRET",
    "CallbackBaseUrl": "https://yourdomain.com"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 10000000,
          "retainedFileCountLimit": 100,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "OtpSettings": {
    "ExpiryMinutes": 5,
    "Length": 6,
    "Provider": "SMS", // SMS or Email
    "Sms": {
      "ApiUrl": "https://sms-provider/api/send",
      "ApiKey": "your-api-key",
      "SenderId": "ORDERAPP"
    },
    "Email": {
      "From": "no-reply@yourapp.com",
      "SmtpHost": "smtp.gmail.com",
      "Port": 587,
      "UserName": "your-email",
      "Password": "your-password"
    }
  },
  "AllowedHosts": "*"
}
